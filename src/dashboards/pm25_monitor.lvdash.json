{
  "datasets": [
    {
      "name": "231f9562",
      "displayName": "latest",
      "queryLines": [
        "SELECT * FROM pm25_latest"
      ]
    },
    {
      "name": "7a24354b",
      "displayName": "province_daily",
      "queryLines": [
        "SELECT * FROM pm25_province_daily"
      ]
    },
    {
      "name": "ranking_today",
      "displayName": "ranking_today",
      "queryLines": [
        "SELECT province_th, measured_date, pm25_avg, n_stations, n_stations_exceed, worst_station,\n",
        "       CASE WHEN pm25_avg <= 15   THEN '1 ดีมาก'\n",
        "            WHEN pm25_avg <= 25   THEN '2 ดี'\n",
        "            WHEN pm25_avg <= 37.5 THEN '3 ปานกลาง'\n",
        "            WHEN pm25_avg <= 75   THEN '4 เริ่มมีผลกระทบต่อสุขภาพ'\n",
        "            ELSE                       '5 มีผลกระทบต่อสุขภาพ' END AS pm25_level\n",
        "FROM pm25_province_daily\n",
        "WHERE measured_date = (SELECT MAX(measured_date) FROM pm25_province_daily)\n",
        "ORDER BY pm25_avg DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "model_daily",
      "displayName": "model_daily",
      "queryLines": [
        "SELECT * FROM pm25_model_province_daily\n"
      ]
    }
  ],
